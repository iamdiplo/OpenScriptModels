//@version=6
indicator("CISD Model+ | Triton Trades", shorttitle = "CISD Model+", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000)
 
const string G_GEN      = "General Settings"
const string G_LIQ      = "Liquidity"
const string G_SESS     = "Session Liquidity"
const string G_FVG      = "Fair Value Gaps"
const string G_CISD     = "CISD Settings"
const string G_HTFCISD  = "Higher Timeframe CISDs"
const string G_SMT      = "SMT Settings"
const string G_RISK     = "Risk & Contract Sizing"
const string G_ALERT    = "Alert Settings"
const string G_WM       = "Watermark / Info Box"
const string G_CHECK    = "Strategy Checklist"
 
const string STY_SOLID  = "Solid"
const string STY_DASH   = "Dashed"
const string STY_DOT    = "Dotted"
 
const string TIP_BIAS         = "Neutral shows bullish and bearish setups. Bullish/Bearish filters the model to a single direction."
const string TIP_HIDEINV      = "Removes every CISD whose stop-loss level has been violated. Keeps the chart clean of false positives."
const string TIP_SETUPS       = "How many CISD lines are retained per direction."
const string TIP_MINGRADE     = "Minimum grade required before a CISD is rendered or fires an alert."
const string TIP_CTFFVG       = "Allows CISDs that deliver from a CURRENT timeframe fair value gap (instead of a liquidity sweep)."
const string TIP_CTFSWEEP     = "Uses current timeframe swing highs/lows as valid liquidity. Turn off to require HTF liquidity only."
const string TIP_PROX         = "Suppresses CISDs that form too close (in price) to an existing CISD of the same direction."
const string TIP_MAXBARS      = "Maximum number of bars allowed between the CISD sequence and the confirmation close."
const string TIP_SWEEP        = "Marks each swing high/low that gets taken and closed back through."
const string TIP_PRESERVE     = "Keeps a session level drawn after it has been swept (shown as a sweep)."
const string TIP_HTFMODE      = "Automatic aligns HTF FVGs to the chart timeframe. Manual lets you pick each timeframe."
const string TIP_POTENTIAL    = "Draws the CISD level BEFORE it is confirmed, so you can see where price must close."
const string TIP_DISABLELBL   = "Hides the label on current-timeframe CISDs (HTF CISD labels stay visible)."
const string TIP_SMTCISD      = "Validates a CISD that did NOT sweep liquidity when SMT exists with the correlated asset."
const string TIP_SLPLACE      = "Stop loss is placed at the wick or the body of the sequence extreme."
const string TIP_SIZING       = "Suggests a contract count from $ risk and stop distance on current-TF CISDs."
const string TIP_HOVER        = "Sizing information is only visible when you hover the CISD label."
const string TIP_MANHTF       = "Override the automatic higher timeframe selection for the multi-TF CISD engine."
const string TIP_SENS         = "Sensitive = every SMT. Normal = medium swings. Strict = major swings only."
const string TIP_RT           = "Plots SMT before the divergence candle closes and trails it in real time."
const string TIP_ALERTS       = "Master switch. Alerts still respect Bias, Min Grade and the session windows below."
 

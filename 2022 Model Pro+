f_findDisplacementFVG(int fromBar, int toBar, bool bullish) =>
    int   fb = na
    float ft = na
    float fbt = na
    int   start = bar_index - toBar
    int   stop  = bar_index - fromBar
    if start >= 0 and stop >= start
        for o = start to stop
            if o + 2 < 4900
                float top    = bullish ? low[o] : low[o + 2]
                float bot    = bullish ? high[o + 2] : high[o]
                bool  dispOK = bullish ? close[o + 1] > open[o + 1] : close[o + 1] < open[o + 1]
                if top > bot and (top - bot) >= fvgMinAtr * atr and dispOK
                    fb  := bar_index - o - 1
                    ft  := top
                    fbt := bot
                    break
    [fb, ft, fbt]


f_breakerFromSwing(int swingBar, float swingPrice, bool isShort) =>
    int   off = bar_index - swingBar
    float opp = isShort ? high[off] : low[off]
    [swingBar, isShort ? opp : swingPrice, isShort ? swingPrice : opp]

